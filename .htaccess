# Apache config — drops directly into the document root.
# Mirrors the rules in _headers (used by Cloudflare/Netlify).

# Default cache: 1 hour
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType application/json "access plus 5 minutes"
  ExpiresByType text/html "access plus 5 minutes"
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(self), camera=(), microphone=()"
</IfModule>

# Basic auth on /admin/* — uncomment and create a .htpasswd in /admin/
# <Directory /admin>
#   AuthType Basic
#   AuthName "Kanaan Admin"
#   AuthUserFile /full/path/to/admin/.htpasswd
#   Require valid-user
# </Directory>

# Pretty 404
ErrorDocument 404 /404.html

# Force HTTPS
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# === Clean URLs (added by tools/clean-urls.js) ===
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Redirect /foo/index.html  ->  /foo/   (and /index.html -> /)
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # 2. Redirect /foo.html  ->  /foo   (preserves query strings)
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # 3. Internally serve /foo.html when /foo is requested and the file exists.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

