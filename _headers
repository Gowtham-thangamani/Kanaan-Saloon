/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=()
  X-XSS-Protection: 1; mode=block
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://connect.facebook.net https://analytics.tiktok.com https://sc-static.net https://www.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.facebook.com https://analytics.tiktok.com https://tr.snapchat.com https://hooks.zapier.com https://hook.eu1.make.com https://hook.us1.make.com; frame-src 'self' https://www.google.com https://www.googletagmanager.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://hooks.zapier.com https://hook.eu1.make.com https://hook.us1.make.com

/admin/*
  X-Robots-Tag: noindex, nofollow
  X-Frame-Options: DENY
  # Production hardening: also enable basic-auth via your hosting provider:
  # - Cloudflare Pages → Access policy → require email login
  # - Netlify → set Basic-Auth via netlify.toml [[headers]] or Identity
  # - Apache → .htaccess AuthType Basic
  # The client-side admin password is a usability gate, not a security boundary.
  Cache-Control: no-store, max-age=0

/thank-you.html
  X-Robots-Tag: noindex

/ar/thank-you.html
  X-Robots-Tag: noindex

/assets/css/*
  Cache-Control: public, max-age=31536000, immutable

/assets/js/*
  Cache-Control: public, max-age=86400

/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

/content/*.json
  Cache-Control: public, max-age=300
  Access-Control-Allow-Origin: *
